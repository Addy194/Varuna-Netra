FROM python:3.11-slim
WORKDIR /app

ARG INSTALL_SAR_SEG_RUNTIME=false

COPY backend/requirements.txt /app/requirements.txt
COPY backend/requirements-ml-runtime.txt /app/requirements-ml-runtime.txt
RUN pip install --no-cache-dir -r /app/requirements.txt \
    && if [ "$INSTALL_SAR_SEG_RUNTIME" = "true" ]; then pip install --no-cache-dir -r /app/requirements-ml-runtime.txt; fi

COPY backend /app
COPY .env.example /app/.env.example
RUN mkdir -p /data/storage /models
EXPOSE 8000
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000"]
