# Varuna-Netra local / SIH demo configuration
# Copy to .env and replace demo credentials before any public deployment.

# Runtime mode
DEMO_MODE=false
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Database
MONGO_URL=mongodb://mongo:27017
DB_NAME=varunanetra

# Authentication — CHANGE THESE outside a local demo
JWT_SECRET=change-me-to-a-long-random-secret
ADMIN_EMAIL=admin@varunanetra.local
ADMIN_PASSWORD=change-me-admin-password
DEMO_SUPERVISOR_EMAIL=supervisor@varunanetra.local
DEMO_SUPERVISOR_PASSWORD=change-me-supervisor-password
DEMO_ANALYST_EMAIL=analyst@varunanetra.local
DEMO_ANALYST_PASSWORD=change-me-analyst-password

# AIS: demo | live
AIS_MODE=demo
AISSTREAM_API_KEY=

# Email: demo | live
EMAIL_MODE=demo
RESEND_API_KEY=
SENDER_EMAIL=

# Storage
STORAGE_MODE=local
LOCAL_STORAGE_DIR=/data/storage

# Durable job queue
JOB_WORKERS=2
JOB_MAX_ATTEMPTS=3
JOB_LEASE_SECONDS=900

# Microsoft Planetary Computer
# GRD access can work without an account; Sentinel-1 RTC requires an account key.
PC_SDK_SUBSCRIPTION_KEY=

# Real SAR segmentation runtime
# Keep false until checkpoints/sar_spill_seg_v2.pt has actually been trained/evaluated.
INSTALL_SAR_SEG_RUNTIME=false
# auto = use v2 when checkpoint/runtime/input are compatible, otherwise fall back to v1.
# off = always use v1. force = treat v2 failures as errors instead of falling back.
SAR_SEG_ENABLE=auto
SAR_SEG_CHECKPOINT=/models/sar_spill_seg_v2.pt
SAR_SEG_THRESHOLD=0.5
SAR_SEG_OVERLAP=64
SAR_SEG_MAX_PIXELS=16777216
